# Required for every processing mode (DRY_RUN and APPLY)
TMDB_BEARER_TOKEN=
SEARXNG_URL=
SEARXNG_TOKEN=

# Required only when --apply writes metadata to the poster repository
GITHUB_TOKEN=

# Source and result data live in the public posters repository.
POSTERS_REPO=zqzqhesam11-blip/KafiaNet-Movie-Posters
POSTERS_BRANCH=main

# SEARXNG_TOKEN must match the Bearer token configured on the separate KafiaNet-SearXNG Hostless app.
# SEARXNG_SECRET belongs only to that SearXNG app and must NOT be copied here.

# Processing defaults. CLI is DRY RUN unless --apply is supplied.
TMDB_LANGUAGE=en-US
BATCH_LIMIT=5
MATCH_ACCEPT_SCORE=0.94
HTTP_TIMEOUT_SECONDS=30
