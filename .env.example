# Required
TMDB_BEARER_TOKEN=
GITHUB_TOKEN=

# Source and result data live in the public posters repository.
POSTERS_REPO=zqzqhesam11-blip/KafiaNet-Movie-Posters
POSTERS_BRANCH=main

# Optional reverse-image search. TinEye is queried by public image URL through SearXNG.
SEARXNG_URL=
SEARXNG_TOKEN=

# Processing defaults. CLI is DRY RUN unless --apply is supplied.
TMDB_LANGUAGE=en-US
BATCH_LIMIT=5
MATCH_ACCEPT_SCORE=0.94
HTTP_TIMEOUT_SECONDS=30
